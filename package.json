{
  "name": "browgent",
  "version": "0.2.0",
  "description": "Local-first browser for AI agents — desktop co-browse, tools, trajectory, policies, MCP",
  "main": "./out/main/index.js",
  "author": "Browgent contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Errr0rr404/browgent.git"
  },
  "bugs": {
    "url": "https://github.com/Errr0rr404/browgent/issues"
  },
  "homepage": "https://github.com/Errr0rr404/browgent#readme",
  "keywords": [
    "electron",
    "browser",
    "ai-agent",
    "browser-automation",
    "mcp",
    "grok",
    "xai",
    "local-first",
    "co-browse"
  ],
  "bin": {
    "browgent-mcp": "./scripts/browgent-mcp.mjs"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "playwright:example": "node examples/playwright-connect.mjs",
    "mcp": "node scripts/browgent-mcp.mjs",
    "mcp:smoke": "node scripts/mcp-bridge-smoke.mjs",
    "test:unit": "tsx scripts/test-tool-schema.mjs && tsx scripts/test-privacy-filter.mjs && tsx scripts/test-policy-security.mjs",
    "test:identity": "node scripts/test-identity-checklist.mjs",
    "demo:hero": "node scripts/demo-hero.mjs",
    "yc:packet": "node scripts/yc-packet.mjs",
    "dev:agent": "BROWGENT_AGENT_ONLY=1 electron-vite dev",
    "dev:headless": "BROWGENT_HEADLESS=1 BROWGENT_AGENT_ONLY=1 electron-vite dev",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64",
    "dist:dir": "npm run build && electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "lucide-react": "^0.511.0",
    "sql.js": "^1.14.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.3.5"
  }
}
