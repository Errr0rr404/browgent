# ── Agent brain (OpenAI-compatible tool-calling) ──────────────────────────
# Default: xAI Grok when XAI_API_KEY is set. Without any key → heuristic mode.
#
# Get a Grok key: https://console.x.ai
XAI_API_KEY=

# Optional overrides (work for any provider)
# BROWGENT_MODEL=grok-4.5
# BROWGENT_BASE_URL=https://api.x.ai/v1
# BROWGENT_API_KEY=          # generic key if you prefer one name for all providers
# BROWGENT_PROVIDER=auto     # auto | grok | openai | openrouter | groq | deepseek | ollama | custom

# ── Agent tuning (all providers) ──────────────────────────────────────────
# Send viewport screenshots to the model so it can SEE pages (canvas/WebGL,
# icon-only buttons, visual layout). Multimodal models only (Grok 4.5, GPT-4o,
# Claude via OpenRouter, …). Off by default — costs extra tokens per screenshot.
# BROWGENT_VISION=1
# Cap completion length per request (positive integer). Unset = provider default.
# Useful to bound cost/runaway on local models; leave unset for reasoning models.
# BROWGENT_MAX_TOKENS=2048

# ── Other providers (pick one; Grok still wins in auto if XAI_API_KEY is set) ─
# OpenAI
# BROWGENT_PROVIDER=openai
# OPENAI_API_KEY=
# BROWGENT_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter (route to Claude, Gemini, etc. via OpenAI-compatible API)
# BROWGENT_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# BROWGENT_MODEL=anthropic/claude-sonnet-4

# Groq
# BROWGENT_PROVIDER=groq
# GROQ_API_KEY=
# BROWGENT_MODEL=llama-3.3-70b-versatile

# DeepSeek
# BROWGENT_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# BROWGENT_MODEL=deepseek-chat

# Local Ollama (OpenAI-compatible /v1)
# BROWGENT_PROVIDER=ollama
# BROWGENT_MODEL=llama3.2
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Any other OpenAI-compatible proxy
# BROWGENT_PROVIDER=custom
# BROWGENT_API_KEY=
# BROWGENT_BASE_URL=https://your-proxy.example/v1
# BROWGENT_MODEL=your-model-id

# Aliases also accepted for Grok:
# SPACE_XAI_API_KEY=
# GROK_API_KEY=

# ── Dual driver + optional Playwright CDP (localhost) ──────────────────────
# Off by default for normal runs. Set a positive port to enable; 0/off/false disables.
# BROWGENT_CDP_PORT=9222
# BROWGENT_CDP=1                  # 1/on enables port 9222; 0/off/false disables
# In-app agent actuation: dom (fast inject) | cdp (real Input events)
# BROWGENT_DRIVER=dom
# Compact shell for automation (implies CDP unless explicitly disabled)
# BROWGENT_AGENT_ONLY=1
# Hide window; drive via CDP / agent tools (implies CDP unless explicitly disabled)
# BROWGENT_HEADLESS=1

# ── MCP bridge (localhost HTTP → STDIO via npm run mcp) ───────────────────
# On by default (port 17342). Token required — auto file userData/mcp-bridge.json
# BROWGENT_MCP=0                 # disable bridge
# BROWGENT_MCP_PORT=17342
# BROWGENT_MCP_TOKEN=            # override auto token (required by clients)
# BROWGENT_MCP_URL=http://127.0.0.1:17342   # for scripts/browgent-mcp.mjs only
# BROWGENT_ALLOW_PRIVATE_HOSTS=1 # allow agent/MCP to open loopback/LAN (default off)
